# Copy this file to .env and provide your own MongoDB Atlas configuration.
MONGODB_URI=
MONGODB_DB_NAME=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CONFIDENCE_THRESHOLD=0.65
GROQ_TIMEOUT_MS=15000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30

# Configure these values in backend/.env before running `python -m app.seed_admin`.
SEED_ADMIN_NAME=Demo Administrator
SEED_ADMIN_EMAIL=demo.admin@example.test
# Choose a unique email and set a 12-128 character password.
SEED_ADMIN_PASSWORD=